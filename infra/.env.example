# Okuldayım yerel geliştirme ortamı değişkenleri.
# Rastgele değerlerle .env üretmek için: ./scripts/generate-dev-env.sh
# Bu değerler yalnızca yerel geliştirme içindir. Üretim sırları Vault'ta tutulur ve repoya girmez.

POSTGRES_DB=okuldayim
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
OKULDAYIM_MIGRATOR_PASSWORD=
VAULT_DB_ADMIN_PASSWORD=

REDIS_APP_PASSWORD=

S3_ACCESS_KEY=
S3_SECRET_KEY=

# Jasmin SMS Gateway isteğe bağlıdır. URL boşken SMS transport devre dışıdır.
# Jasmin hesabı Vault bootstrap sırasında KV'ye aktarılır; API'ye parola verilmez.
OKD_SMS_GATEWAY_URL=
JASMIN_USERNAME=
JASMIN_PASSWORD=

# Host portları (hepsi yalnızca 127.0.0.1'e bağlanır)
POSTGRES_PORT=5432
REDIS_PORT=6379
VAULT_PORT=8200
S3_PORT=9000
S3_CONSOLE_PORT=9001
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=8080
OKD_DB_MAX_CONNECTIONS=12
